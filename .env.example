# ==================== 🆓 FREE Models Configuration ====================
# DocuSense uses 100% FREE and open-source models by default!
# No API keys or credits required for core functionality.

# ==================== Environment ====================
ENVIRONMENT=dev


# ==================== LLM Model Settings (FREE) ====================
# Ollama - Run LLMs locally for FREE
# Install: https://ollama.ai/
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_CHAT_MODEL=llama3.2:3b
DEFAULT_SMART_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Alternative FREE options:
# - llama3.1:8b (better quality, slower)
# - mistral:7b (good balance)
# - phi3:mini (very fast, 3.8B params)


# ==================== Embedding Settings (FREE) ====================
# Sentence Transformers - Local embeddings, no API needed
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# Alternative FREE embeddings:
# - all-mpnet-base-v2 (768 dim, better quality)
# - paraphrase-MiniLM-L3-v2 (384 dim, fastest)


# ==================== OPTIONAL: Commercial APIs (for comparison only) ====================
# These are NOT required! Only use if you want to compare with commercial models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# Gemini API (FREE tier) - For Phase 1 image understanding & query rewriting
# Get your FREE API key: https://aistudio.google.com/apikey
# FREE tier: 1500 images/day, 15 requests/minute, 1M tokens/day
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash


# ==================== Document Processing (Phase 1) ====================
# File handling
# Allowed file types are configured in settings.py: .pdf, .doc, .txt, .md, .pptx, .xlsx
# ALLOWED_FILE_TYPES=.pdf,.docx,.txt,.md,.pptx,.xlsx
MAX_FILE_SIZE_MB=100

# Document conversion
CONVERT_TO_MARKDOWN=true
PRESERVE_IMAGES=true

# Image processing (FREE)
USE_IMAGE_UNDERSTANDING=true
IMAGE_VISION_PROVIDER=gemini  # Options: gemini, llava, ocr-only
GEMINI_RATE_LIMIT_PER_MIN=15  # FREE tier limit
IMAGE_FALLBACK_TO_OCR=true
MAX_IMAGE_SIZE_MB=5

# Ollama vision model (FREE backup for image understanding)
# Install: ollama pull llava:7b
OLLAMA_VISION_MODEL=llava:7b


# ==================== Chunking Settings (Phase 1) ====================
# Token limits for semantic chunking
MIN_CHUNK_TOKENS=200
MAX_CHUNK_TOKENS=800
TARGET_CHUNK_TOKENS=500
EMBEDDING_TOKEN_LIMIT=512

# Chunking strategy
# Chunking strategy
CHUNK_SIZE=500  # Legacy - use TARGET_CHUNK_TOKENS
CHUNK_OVERLAP=50
CHUNKING_STRATEGY=semantic  # Options: fixed, semantic, sliding

# Semantic chunking (Markdown-aware)
SPLIT_ON_HEADERS=true
PRESERVE_CODE_BLOCKS=true
PRESERVE_TABLES=true
OVERLAP_STRATEGY=sentence  # Options: token, sentence


# ==================== Retrieval Settings ====================
VECTOR_STORE_TYPE=faiss
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Hybrid retrieval
USE_HYBRID_SEARCH=true
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
FUSION_METHOD=rrf

# Re-ranking
USE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=20


# ==================== Query Processing ====================
ENABLE_QUERY_REWRITING=true
ENABLE_INTENT_CLASSIFICATION=true
ENABLE_STRATEGY_PLANNING=true


# ==================== Answer Generation ====================
MAX_CONTEXT_TOKENS=3000
ANSWER_MAX_TOKENS=500
TEMPERATURE=0.0
INCLUDE_CITATIONS=true


# ==================== System Settings ====================
LOG_LEVEL=INFO
LOG_FILE=logs/docusense.log
LOG_ROTATION=500 MB
LOG_RETENTION=10 days

CACHE_ENABLED=true
CACHE_DIR=data/.cache


# ==================== API Settings (FastAPI) ====================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_TITLE=DocuSense API
API_DESCRIPTION=Intelligent Document Q&A using RAG


# ==================== UI Settings (Gradio) ====================
UI_SHARE=false
UI_SERVER_NAME=0.0.0.0
UI_SERVER_PORT=7860


# ==================== Deployment (Modal.com) ====================
MODAL_DEPLOYMENT=false
MODAL_GPU=any
MODAL_CPU=2
MODAL_MEMORY=4096
MODAL_TIMEOUT=600


# ==================== Evaluation ====================
GOLDEN_DATASET_PATH=data/evaluation/golden_queries.json
ENABLE_QUERY_LOGGING=true


# ==================== Rate Limiting ====================
MAX_RETRIES=3
RETRY_DELAY=1.0
TIMEOUT=30

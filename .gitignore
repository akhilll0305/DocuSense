# Data directories (keep structure + test fixtures, ignore generated content)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/vector_stores/*
!data/vector_stores/.gitkeep
data/.cache/

# Generated databases and vector stores (regenerated by ingestion)
data/*.db
data/qdrant/
data/benchmarks/*.json
# These reports back the numbers quoted in the README and BENCHMARKS.md, so
# they are committed as evidence. Everything else under data/benchmarks/ is
# either the downloaded QASPER dataset or a scratch run.
!data/benchmarks/qasper_ablation_report.json
!data/benchmarks/routed_subset_report.json
!data/benchmarks/query_rewriting_report.json
data/benchmarks/qasper/

# Evaluation data (keep test sets but ignore results)
data/evaluation/*_results.json
data/evaluation/*_report.html

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Jupyter Notebooks

# Keep the build context small and secrets out of the image.

# Secrets — never bake credentials into a layer
.env
.env.local
.env.*.local

# Virtual environments (the image builds its own)
venv/
.venv/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data: databases, vector store, uploaded and converted documents.
# These are mounted as volumes at runtime.
data/
logs/

# ...except the demo papers, which a public instance seeds itself with on
# start. Free hosting tiers have ephemeral storage, so this has to be in the
# image rather than something loaded once by hand.
!data/demo/

# Version control and CI
.git/
.github/
.gitignore

# Docs and tests are not needed at runtime
docs/
tests/
*.md
!README.md

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
